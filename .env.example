# Copy this file to .env before the first `docker compose up`.
#
#   cp .env.example .env
#
# .env is read by two things: Laravel inside the containers, and docker compose
# itself (for the port, the time zone and the MySQL credentials). Never commit it.
# Every value here is a placeholder — replace the secrets with real ones.

APP_NAME="MealPlanner Milly"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The clock for all three containers — compose passes it as TZ to app, scheduler
# and db — so logs and `date` read in kitchen time. Also the scheduler's fallback
# zone, until the `time_zone` setting is readable from the database. Not Laravel's
# own clock: config('app.timezone') is fixed at UTC, so every stored timestamp is
# an absolute instant.
#
# The household's own time zone is the `time_zone` setting on the Settings page
# (MM-4) — AppServiceProvider hands that to the scheduler as soon as settings can
# be read. This line exists only because the zone has to be known before the app
# can read a setting: the bootstrap exception AGENTS.md allows.
HOUSEHOLD_TIMEZONE=America/Toronto

# Change this to the home machine's LAN address (e.g. http://192.168.1.50:8000) once
# MM-10 deploys it, so links in Slack posts resolve on the home network.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# DB_HOST is the compose service name: the app reaches MySQL over the Docker
# network, and MySQL's port is never published to the host.
# Changing DB_DATABASE / DB_USERNAME / DB_PASSWORD only takes effect on a fresh
# volume, so set them before the first boot or run `docker compose down -v`.
# The test suite uses a second database named "<DB_DATABASE>_test".
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=milly
DB_USERNAME=milly
DB_PASSWORD=milly-dev-password

# Only used by the `db` container itself.
DB_ROOT_PASSWORD=milly-dev-root-password

# --- Slack (MM-9 posts the plan, the grocery list and reminders) ------------
# Placeholders only. Create a Slack app, give it the chat:write scope, invite it to
# the household channel, then paste the bot token here. The real token lives in
# .env and nowhere else. Names match config/services.php ('slack.notifications').
SLACK_BOT_USER_OAUTH_TOKEN=xoxb-replace-with-real-bot-token
SLACK_BOT_USER_DEFAULT_CHANNEL=#meal-plan

# --- Framework drivers (database-backed, so nothing extra has to run) -------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# --- Docker Compose only ----------------------------------------------------
# The host port for the web UI. Change it if something else already uses 8000.
APP_PORT=8000

# On Linux hosts set these to `id -u` / `id -g` so files the container writes into
# the project stay editable. Docker Desktop on macOS ignores them.
APP_UID=1000
APP_GID=1000

VITE_APP_NAME="${APP_NAME}"
