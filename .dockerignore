# The project is bind-mounted at runtime, so the build context only needs the
# files the Dockerfile actually copies. Keeping it small makes `build` fast.
**/.DS_Store
.env
.env.*
!.env.example
.git
.gitignore
.idea
.vscode
node_modules
public/build
public/hot
public/storage
storage/*.key
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
vendor
